#!/bin/sh
# Blocks accidental commits of secrets and local state.
# Enable with: git config core.hooksPath .githooks

for f in $(git diff --cached --name-only); do
  blocked=0
  case "$f" in
    .env|*.db|data/*)
      blocked=1
      ;;
    .env.*)
      [ "$f" = ".env.example" ] || blocked=1
      ;;
  esac
  if [ "$blocked" = "1" ]; then
    echo "BLOCKED: '$f' must not be committed (secrets or local data)."
    exit 1
  fi
done

if git diff --cached -U0 | grep '^+' | grep -qE '(sk-or-[A-Za-z0-9_-]{20,}|[0-9]{8,10}:[A-Za-z0-9_-]{30,})'; then
  echo "BLOCKED: staged diff looks like it contains an API key or bot token."
  exit 1
fi

exit 0
